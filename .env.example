# Environment variables for Orbital Audit
# Copy this file to `.env.local` and fill in the values you have.
# The marketing site + guest demo work WITHOUT any keys — analysis
# falls back to demo data and the account area stays gated/offline.

# ── Analysis engine (used by /api/analyze and the dashboard) ─────────
# Google PageSpeed Insights API key (URL mode → Lighthouse metrics).
# Get one at: https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=

# Optional: Chrome UX Report (CrUX) API key for real-world field vitals.
# Falls back to PAGESPEED_API_KEY when unset. Same Google Cloud console.
CRUX_API_KEY=

# Anthropic API key (AI recommendations for code / screenshot / URL refine).
# Get one at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: override the Claude model used for analysis. Defaults to claude-sonnet-5-5.
ANALYSIS_MODEL=claude-sonnet-5-5

# ── Supabase (auth + Postgres + storage) ─────────────────────────────
# Project settings → API. The anon key is public (ships to the browser);
# the service-role key is server-only — NEVER expose it to the client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of this app (used for OAuth redirects, QStash callbacks,
# Stripe return URLs). e.g. http://localhost:3000 in dev.
APP_URL=http://localhost:3000

# Stable secret so encrypted Server Action closures survive restarts /
# multiple instances. Generate: `openssl rand -base64 32`.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# ── Stripe (test mode) — billing ─────────────────────────────────────
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From `stripe listen` or the webhook endpoint config.
STRIPE_WEBHOOK_SECRET=
# Price IDs for the paid plans (test-mode price objects).
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=

# ── Upstash QStash — scheduled re-audits (HTTP-push cron) ─────────────
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
